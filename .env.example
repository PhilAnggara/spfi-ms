APP_NAME="SPFI-MS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# External Fish system (opened from sidebar)
FISH_SYSTEM_URL=http://192.168.11.159/testing/

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

#--------------------------------------------------------------------------
# Database Configuration - Profile Selection
#--------------------------------------------------------------------------
# Lihat docs/environment-profiles.md untuk template .env lengkap per skenario:
#   - Laptop rumah (MySQL)
#   - Laptop kantor (MySQL + pull production)
#   - PC kantor (SQL Server spfi_ms_dev + pull production)
#
# DB_PROFILE:
#   1 = Home (local MySQL on personal laptop)
#   2 = Office (SQL Server on office network)
#
DB_PROFILE=1

#-------------- MySQL Configuration (for home) --------------
DB_MYSQL_HOST=127.0.0.1
DB_MYSQL_PORT=3306
DB_MYSQL_DATABASE=spfi_ms
DB_MYSQL_USERNAME=root
DB_MYSQL_PASSWORD=

#-------------- SQL Server Configuration (for office) --------------
# Dev database on the office SQL Server. Must NOT be the production name.
DB_SQLSRV_HOST=192.168.11.250
DB_SQLSRV_PORT=1433
DB_SQLSRV_DATABASE=spfi_ms_dev
DB_SQLSRV_USERNAME=sa
DB_SQLSRV_PASSWORD=YourPasswordHere
DB_SQLSRV_ENCRYPT=no
DB_SQLSRV_TRUST_SERVER_CERTIFICATE=true

#-------------- Production SQL Server (source for db:pull-production) --------------
# Run php artisan db:pull-production at the office to full-replace the current
# DB_PROFILE target (MySQL spfi_ms or SQL Server spfi_ms_dev) from production.
PROD_DB_HOST=192.168.11.250
PROD_DB_PORT=1433
PROD_DB_DATABASE=spfi_ms
PROD_DB_USERNAME=sa
PROD_DB_PASSWORD=YourPasswordHere
PROD_DB_ENCRYPT=no
PROD_DB_TRUST_SERVER_CERTIFICATE=true

# Legacy connection fallback (for backward compatibility)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=spfi_ms
DB_USERNAME=root
DB_PASSWORD=

# After migrate:fresh --seed: php artisan db:snapshot
# When dev DB is empty:     php artisan db:restore
# At the office, refresh dev from production: php artisan db:pull-production
# Optional CLI paths: MYSQL_BIN_PATH, SQLSERVER_BIN_PATH
# Remote SQL Server snapshot folder (path on SQL Server host, not your PC):
# SQLSERVER_SNAPSHOT_PATH=\\192.168.11.250\database\spfi_ms_dev

# Global seeding source selection. Options: 'local' or 'legacy'.
# local = use existing seeders/CSV files
# legacy = import from legacy SQL Server database
SEED_SOURCE=local
SEED_SOURCE_FALLBACK_TO_LOCAL=true
LEGACY_DB_DEFAULT_CONNECTION=legacy_sqlsrv_1

# Incremental IMS → spfi_ms reconcile (see docs/dual-system-reconciliation.md)
RECONCILE_FREEZE_WRITES=false
RECONCILE_DEFAULT_SINCE=2026-07-15
RECONCILE_CONFLICT=import-as-alias
# RECONCILE_LEGACY_CONNECTION=legacy_sqlsrv_1
# RECONCILE_REPORT_PATH=reconcile-reports

# Legacy SQL Server connection #1.
LEGACY_DB1_HOST=127.0.0.1
LEGACY_DB1_PORT=1433
LEGACY_DB1_DATABASE=
LEGACY_DB1_USERNAME=
LEGACY_DB1_PASSWORD=
LEGACY_DB1_ENCRYPT=no
LEGACY_DB1_TRUST_SERVER_CERTIFICATE=true

# Legacy SQL Server connection #2.
LEGACY_DB2_HOST=127.0.0.1
LEGACY_DB2_PORT=1433
LEGACY_DB2_DATABASE=
LEGACY_DB2_USERNAME=
LEGACY_DB2_PASSWORD=
LEGACY_DB2_ENCRYPT=no
LEGACY_DB2_TRUST_SERVER_CERTIFICATE=true

# Legacy SQL Server connection #3.
LEGACY_DB3_HOST=127.0.0.1
LEGACY_DB3_PORT=1433
LEGACY_DB3_DATABASE=
LEGACY_DB3_USERNAME=
LEGACY_DB3_PASSWORD=
LEGACY_DB3_ENCRYPT=no
LEGACY_DB3_TRUST_SERVER_CERTIFICATE=true

# Optional per-dataset routing (connection & table)
# LEGACY_DB_UOM_CONNECTION=legacy_sqlsrv_1
# LEGACY_DB_UOM_TABLE=uom
# LEGACY_DB_PRODUCT_CATEGORY_CONNECTION=legacy_sqlsrv_1
# LEGACY_DB_PRODUCT_CATEGORY_TABLE=product_category
# LEGACY_DB_PRODUCT_CONNECTION=legacy_sqlsrv_1
# LEGACY_DB_PRODUCT_TABLE=product
# LEGACY_DB_SUPPLIER_CONNECTION=legacy_sqlsrv_1
# LEGACY_DB_SUPPLIER_TABLE=supplier
# LEGACY_DB_CUSTOMS_DOCUMENT_TYPE_CONNECTION=legacy_sqlsrv_2
# LEGACY_DB_CUSTOMS_DOCUMENT_TYPE_TABLE=tbl_BCName
# LEGACY_DB_ACCT_SUB_GROUP_CONNECTION=legacy_sqlsrv_3
# LEGACY_DB_ACCT_SUB_GROUP_TABLE=tbl_Acct_SubGroup
# LEGACY_DB_ACCT_GROUP_CODES_CONNECTION=legacy_sqlsrv_3
# LEGACY_DB_ACCT_GROUP_CODES_TABLE=tbl_Acct_GroupCodes
# LEGACY_DB_ACCOUNTING_CODES_CONNECTION=legacy_sqlsrv_3
# LEGACY_DB_ACCOUNTING_CODES_TABLE=tbl_AccountingCodes
# LEGACY_DB_BS_GROUPING_CONNECTION=legacy_sqlsrv_3
# LEGACY_DB_BS_GROUPING_TABLE=tbl_BSGrouping
# LEGACY_DB_PRS_CONNECTION=legacy_sqlsrv_1
# LEGACY_DB_PRS_TABLE=prs
# LEGACY_DB_PRS_DETAIL_CONNECTION=legacy_sqlsrv_1
# LEGACY_DB_PRS_DETAIL_TABLE=prs_detail
# LEGACY_DB_ASSIGN_CANV_CONNECTION=legacy_sqlsrv_1
# LEGACY_DB_ASSIGN_CANV_TABLE=assign_canv
# LEGACY_DB_ASSIGN_CANV_DTL_CONNECTION=legacy_sqlsrv_1
# LEGACY_DB_ASSIGN_CANV_DTL_TABLE=assign_canv_dtl
# LEGACY_DB_ASSIGN_CANV_PRC_CONNECTION=legacy_sqlsrv_1
# LEGACY_DB_ASSIGN_CANV_PRC_TABLE=assign_canv_prc
# LEGACY_DB_SWS_CONNECTION=legacy_sqlsrv_1
# LEGACY_DB_SWS_TABLE=sws
# LEGACY_DB_SWS_DETAIL_CONNECTION=legacy_sqlsrv_1
# LEGACY_DB_SWS_DETAIL_TABLE=sws_detail
# LEGACY_DB_DOC_TRAN_CONNECTION=legacy_sqlsrv_3
# LEGACY_DB_DOC_TRAN_TABLE=tbl_DocTran
# LEGACY_DB_DOC_TRAN_DETAILS_CONNECTION=legacy_sqlsrv_3
# LEGACY_DB_DOC_TRAN_DETAILS_TABLE=tbl_DocTranDetails

SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Reverb Configuration
REVERB_APP_ID=spfi-ms-local
REVERB_APP_KEY=spfi-ms-local-key
REVERB_APP_SECRET=spfi-ms-local-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

# Pusher Configuration
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
PUSHER_SCHEME=https
PUSHER_HOST=
PUSHER_PORT=443

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
