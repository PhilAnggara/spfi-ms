{
    "name": "SPFI-MS",
    "user": "ubuntu",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "install": "bash .cursor/install.sh",
    "terminals": [
        {
            "name": "server",
            "command": "php artisan serve --host=0.0.0.0 --port=8000"
        },
        {
            "name": "vite",
            "command": "npm run dev"
        },
        {
            "name": "queue",
            "command": "php artisan queue:listen --tries=1"
        },
        {
            "name": "reverb",
            "command": "php artisan reverb:start --host=0.0.0.0 --port=8080"
        }
    ],
    "ports": [
        8000,
        5173,
        8080
    ]
}
