# Copy this file to Caddyfile and set YOUR machine's LAN IP.
#   copy Caddyfile.example Caddyfile
# Caddyfile is gitignored (each PC/laptop has a different IP).
#
# Keep `php artisan serve --host=0.0.0.0 --port=8000` running as usual.
# Development on :8001 is intentionally not proxied.
#
# Usage (from project root, as Administrator the first time for tls internal CA):
#   caddy run --config Caddyfile
#
# Users (replace IP with yours):
#   http://YOUR_LAN_IP:8000  — existing HTTP access (no camera)
#   https://YOUR_LAN_IP      — HTTPS via Caddy (camera works)
#
# Examples:
#   Laptop  → 192.168.11.15
#   PC prod → 192.168.11.16

{
	# Don't bind :80 (XAMPP/Apache often owns it). HTTP :8000 stays for artisan serve.
	auto_https disable_redirects
}

https://YOUR_LAN_IP {
	tls internal

	# Laravel Reverb / Echo WebSocket (default local port 8080)
	handle /app/* {
		reverse_proxy 127.0.0.1:8080
	}

	handle {
		reverse_proxy 127.0.0.1:8000
	}
}
